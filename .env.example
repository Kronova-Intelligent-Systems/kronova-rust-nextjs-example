# Required: Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Required for deployed auth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Optional: AI analytics (server-only)
OPENAI_API_KEY=

# Optional: Plaid banking (server-only)
PLAID_CLIENT_ID=
PLAID_ENV=sandbox
PLAID_SANDBOX_SECRET=
PLAID_SECRET=
PLAID_ENCRYPTION_KEY=

# Optional: transactional email (server-only)
RESEND_API_KEY=

# Optional: Kronova internal API and webhook authentication (server-only)
KRONOVA_API_KEY=
KRONOVA_WEBHOOK_SECRET=

# Optional: blockchain asset imports (server-only)
ETHERSCAN_API_KEY=

# Optional: web push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: Stripe billing (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Never commit real values. Configure secrets in Vercel Project Settings > Environment Variables.
# Public NEXT_PUBLIC_* values must not contain credentials.

# Integration setup:
# Supabase: https://supabase.com/dashboard
# Plaid: https://dashboard.plaid.com/developers/keys
# Resend: https://resend.com/api-keys
# OpenAI: https://platform.openai.com/api-keys
# Stripe: https://dashboard.stripe.com/apikeys
# Etherscan: https://etherscan.io/myapikey
